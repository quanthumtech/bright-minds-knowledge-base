# Bright Minds Knowledge Base: variáveis do Dokploy (aba Environment do serviço Compose).
# Copie, preencha e NÃO versione o arquivo preenchido.

# --- Aplicação
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=               # URL pública do domínio configurado no Dokploy, com https://
NAO_DB_PASSWORD=               # openssl rand -hex 16 (Postgres do histórico de chat)
ENABLE_USER_SIGNUP=false       # mantenha false: o primeiro usuário é criado na tela inicial; os demais por convite

# --- LLM (preencha pelo menos um)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Banco do CRM (Supabase auto-hospedado). Valores impressos por bright-minds/scripts/create-readonly-role.sh
SUPABASE_NETWORK=              # rede Docker do Supabase (docker network ls | grep supabase)
CRM_DB_HOST=                   # nome do container do banco (ex.: bright-minds-supabase-xxxxxx-db-1)
CRM_DB_PORT=5432
CRM_DB_NAME=postgres
CRM_DB_USER=cerebro_ro
CRM_DB_PASSWORD=               # senha do usuário somente leitura cerebro_ro
