# Perfil "staging": o banco do CRM recém-migrado (Supabase no Dokploy), acessado por túnel SSH.
# Copie para .env.staging (ignorado pelo git) e preencha. Passo a passo: bright-minds/README.md, seção "Rodar localmente".
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5005
ANTHROPIC_API_KEY=             # ou OPENAI_API_KEY
OPENAI_API_KEY=
CRM_DB_HOST=localhost          # o túnel SSH escuta aqui
CRM_DB_PORT=55433              # porta local do túnel: ssh -N -L 55433:<IP-do-container-do-banco>:5432 root@<servidor>
CRM_DB_NAME=postgres
CRM_DB_USER=cerebro_ro
CRM_DB_PASSWORD=               # impressa por bright-minds/scripts/create-readonly-role.sh
